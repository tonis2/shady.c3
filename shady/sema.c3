<*
 Types and layout for the shady language (see LANGUAGE.md sections 2 and 7).

 The type table is built once per compile: builtins first, then one entry per
 user struct. Types are interned by name, so two references to `float4` are the
 same Type* and comparing types is a pointer comparison.
*>
module shady;

import std::collections::list;

<*
 Raised when one struct is nested in two blocks that lay it out differently.
 The type is interned by name, so the second layout would overwrite the first
 and half the fields would be read at the wrong offset.
*>
faultdef LAYOUT_CONFLICT;

enum TypeKind : char
{
	VOID,
	BOOL,
	INT,
	UINT,
	FLOAT,
	VECTOR,
	MATRIX,
	ARRAY,
	STRUCT,
	TEXTURE,
	SAMPLER,
	SAMPLED_IMAGE, // a combined image and sampler, `Sampler2D`
	POINTER, // a buffer device address; `element` is the pointee
	COOPMAT, // a cooperative matrix: one tile per workgroup, `coopmat<float, 16, 16, workgroup>`
}

struct StructMember
{
	String      name;
	Type*       type;
	Attribute[] attributes;

	// Filled in by layout and stage lowering.
	uint offset;      // std140 byte offset, uniform blocks only
	uint location;    // stage I/O location
	bool is_position; // carries @position, so it is BuiltIn Position
	bool is_builtin;  // carries @builtin(...)
	Builtin builtin;  // the SPIR-V BuiltIn, when is_builtin
}

struct Type
{
	TypeKind kind;
	String   name;

	Type* element; // vector component type, or matrix column type
	uint  count;   // vector components, or matrix columns

	StructMember[] members; // STRUCT only
	Dim            dim;     // TEXTURE and SAMPLED_IMAGE: the OpTypeImage dimension

	// INT, UINT and FLOAT: the width in bits. Zero means 32, which is what
	// every scalar was before cooperative matrices needed a byte tile.
	uint bits;

	// SAMPLED_IMAGE only: the OpTypeImage Depth operand, 1 for a comparison
	// sampler such as Sampler2DShadow.
	uint depth;

	// ARRAY only: no declared length, so it is an OpTypeRuntimeArray. Legal as
	// the tail of a storage block and nowhere else.
	bool runtime;

	<*
	 The block a bare runtime-sized array was bound as - generated by
	 `wrap_runtime_array`, never written by a shader. Its one member is the
	 array, and indexing the variable steps through it.
	*>
	bool runtime_array_block;

	<*
	 What kind of block this struct is, from its `@uniform`, `@pushconstant`,
	 `@storage` or `@address` attribute. NONE for an ordinary struct.
	*>
	BlockKind block;

	// COOPMAT only: the tile's shape. The element type is `element`, `count`
	// is the column count, and the row count is `rows`.
	uint rows;
	uint scope;    // COOPMAT: the SPIR-V scope id (Workgroup 2, Subgroup 3)
	uint use;      // COOPMAT: MatrixAKHR 0, MatrixBKHR 1, MatrixAccumulatorKHR 2

	Id id;         // cached SPIR-V id, 0 until emitted
	Id pointer_id; // ADDRESS only: the PhysicalStorageBuffer pointer to it

	<*
	 Set once `assign_offsets` has run, with the layout it ran under. A struct
	 nested in two differently laid-out blocks is an error rather than one
	 layout silently winning.
	*>
	bool   laid_out;
	Layout layout;

	<*
	 Set once this struct's members have been decorated as part of a block, so
	 a struct nested by two members of the same block is decorated once.
	*>
	bool members_decorated;
}

<*
 How a struct is used, which decides its layout, its storage class, and
 whether it takes a descriptor binding (LANGUAGE.md section 3.3).

 A struct carries at most one of these. It is a property of the type rather
 than of the variable, because `Vertex*` has to know the pointee is
 address-reachable before any variable of that type exists.
*>
enum BlockKind : char
{
	NONE,          // an ordinary struct: locals, parameters, stage I/O
	UNIFORM,       // @uniform      - a descriptor, std140
	PUSH_CONSTANT, // @pushconstant - the pipeline's push constants, std430
	STORAGE,       // @storage      - a storage buffer descriptor, std430
	ADDRESS,       // @address      - reached by device address, std430
}

<*
 Map an attribute name to its block kind. Returns false for anything else, so
 the caller can leave unrelated attributes alone.
*>
fn bool block_kind_from_name(String name, BlockKind* out)
{
	switch (name)
	{
		case "uniform":      *out = UNIFORM;
		case "pushconstant": *out = PUSH_CONSTANT;
		case "storage":      *out = STORAGE;
		case "address":      *out = ADDRESS;
		default: return false;
	}
	return true;
}

fn String BlockKind.attribute(self)
{
	switch (self)
	{
		case UNIFORM:       return "@uniform";
		case PUSH_CONSTANT: return "@pushconstant";
		case STORAGE:       return "@storage";
		case ADDRESS:       return "@address";
		default:            return "";
	}
}

<*
 std140 for uniform blocks, std430 for everything else (LANGUAGE.md section 7).
*>
fn Layout BlockKind.layout(self) => self == UNIFORM ? STD140 : STD430;

alias TypePtrList = List{Type*};

struct TypeTable
{
	Allocator   allocator;
	TypePtrList types;
}

fn Type* TypeTable.add(&self, TypeKind kind, String name, Type* element = null, uint count = 0, Dim dim = Dim.D1)
{
	Type* type = alloc::new(self.allocator, Type);
	*type = { .kind = kind, .name = name, .element = element, .count = count, .dim = dim };
	self.types.push(type);
	return type;
}

<*
 The device-address pointer type for a buffer struct, created on first use and
 interned under the name `T*` so `Vertex*` written twice is one Type.
*>
fn Type* TypeTable.pointer_to(&self, Type* pointee)
{
	String name = string::format(self.allocator, "%s*", pointee.name);
	if (Type* existing = self.find(name)) return existing;
	return self.add(POINTER, name, pointee);
}

<*
 A cooperative matrix type, interned under its own name so two declarations of
 the same shape are one `OpTypeCooperativeMatrixKHR`.

 The name is built from the shape rather than looked up by symbol, which is
 what keeps `coopmat<float, 16, 16, workgroup>` and `coopmat<float, 16, 8,
> group>` two types the moment their shapes differ.
*>
fn Type* TypeTable.coopmat_of(&self, Type* element, uint rows, uint columns, uint scope, uint use,
	String scope_name, String use_name)
{
	String name = string::format(self.allocator, "coopmat<%s, %d, %d, %s, %s>",
		element.name, rows, columns, scope_name, use_name);
	if (Type* existing = self.find(name)) return existing;

	Type* type = self.add(COOPMAT, name);
	type.element = element;
	type.rows    = rows;
	type.count   = columns;
	type.scope   = scope;
	type.use     = use;
	return type;
}

fn Type* TypeTable.find(&self, String name)
{
	foreach (type : self.types)
	{
		if (type.name == name) return type;
	}
	return null;
}

<*
 An array of `count` elements. Not interned, like a struct: an array declaration
 is one place, and its stride depends on the block it ends up in, so it is
 computed from the layout at the point the size or the decoration is needed.
*>
fn Type* TypeTable.array_of(&self, Type* element, uint count)
{
	String name = string::format(self.allocator, "%s[%d]", element.name, count);
	return self.add(ARRAY, name, element, count);
}

fn uint array_stride(Type* element, Layout layout)
{
	uint stride = round_up(element.size(layout), element.align(layout));
	return layout == STD140 ? round_up(stride, 16) : stride;
}

<*
 Whether a type may be the element of a runtime-sized array - the shape every
 storage buffer is: `float data[];` or `float4 rows[];`.

 A struct is legal because it is laid out by the buffer that contains it, and a
 struct the block cannot lay out is refused where it is declared. Opaque types
 are left out: a runtime-sized *descriptor* array is a different feature, and
 it is spelled as a module-level variable, not as a block member.
*>
fn bool Type.may_back_a_runtime_array(&self)
{
	return self.is_scalar() || self.kind == VECTOR || self.kind == MATRIX || self.kind == STRUCT;
}

<*
 The block a bare runtime-sized array is bound as: `float data[];` is one
 `@storage` struct holding one member, the array, and the buffer's name is the
 variable's.

 SPIR-V has no runtime-sized array at the top level of a descriptor - a storage
 buffer *is* a struct whose last member is one - so the wrapper is what makes
 the short spelling a storage buffer rather than a special case everywhere
 below. The generated type is deliberately not looked up by name: two
 `float data[];` declarations are two types, which is one `FloatArray` too many
 only in a world where a runtime array could be shared, and it cannot.

 Nothing about it is visible to the shader: the member is named after the
 array's element type, and a block with one member is reached exactly as the
 array was - `data[i]` resolves as `data.data[i]` would, one access chain
 longer and no different to read.

 @param array : `A runtime-sized array, resolved from the declaration's type.`
*>
fn Type* TypeTable.wrap_runtime_array(&self, Type* array)
{
	StructMember[] members = alloc::alloc_array(self.allocator, StructMember, 1);
	members[0] = { .name = array.element.name, .type = array };

	Type* block   = self.add(STRUCT, string::format(self.allocator, "%s[]", array.element.name));
	block.members = members;
	block.block   = STORAGE;
	block.runtime_array_block = true;
	return block;
}

<*
 Register the builtin types. Names are spelled out rather than generated so
 that `find` stays a plain string match and a typo in a shader can never
 accidentally name a type that was never meant to exist.
*>
fn void TypeTable.init(&self, Allocator allocator)
{
	self.allocator = allocator;
	self.types.init(allocator, 64);

	self.add(VOID, "void");
	Type* bool_t  = self.add(BOOL, "bool");
	Type* int_t   = self.add(INT, "int");
	Type* uint_t  = self.add(UINT, "uint");
	Type* float_t = self.add(FLOAT, "float");

	// The byte-width integers exist for cooperative matrices: the hardware's
	// integer matmul takes 8-bit operands and accumulates in 32. Everything
	// outside a coopmat keeps to the 32-bit spelling.
	self.add(INT, "int8").bits   = 8;
	self.add(UINT, "uint8").bits = 8;

	Type*[4] float_vectors;
	float_vectors[0] = float_t;

	String[3] vector_names = { "float2", "float3", "float4" };
	foreach (i, name : vector_names)
	{
		float_vectors[i + 1] = self.add(VECTOR, name, float_t, (uint)i + 2);
	}

	String[3] int_names  = { "int2", "int3", "int4" };
	String[3] uint_names = { "uint2", "uint3", "uint4" };
	String[3] bool_names = { "bool2", "bool3", "bool4" };
	foreach (i, name : int_names)  self.add(VECTOR, name, int_t, (uint)i + 2);
	foreach (i, name : uint_names) self.add(VECTOR, name, uint_t, (uint)i + 2);
	foreach (i, name : bool_names) self.add(VECTOR, name, bool_t, (uint)i + 2);

	// floatCxR: C columns of R rows, so the column type is floatR.
	for (uint columns = 2; columns <= 4; columns++)
	{
		for (uint rows = 2; rows <= 4; rows++)
		{
			String name = string::format(allocator, "float%dx%d", columns, rows);
			self.add(MATRIX, name, float_vectors[rows - 1], columns);
		}
	}

	self.add(TEXTURE, "texture1d", float_vectors[3], 0, Dim.D1);
	self.add(TEXTURE, "texture2d", float_vectors[3], 0, Dim.D2);
	self.add(TEXTURE, "texture3d", float_vectors[3], 0, Dim.D3);
	self.add(TEXTURE, "texturecube", float_vectors[3], 0, Dim.CUBE);
	self.add(SAMPLER, "sampler");

	self.add(SAMPLED_IMAGE, "Sampler2D", float_vectors[3], 0, Dim.D2);
	Type* shadow_2d = self.add(SAMPLED_IMAGE, "Sampler2DShadow", float_vectors[3], 0, Dim.D2);
	shadow_2d.depth = 1;
}

// --- Queries -----------------------------------------------------------------

fn bool Type.is_scalar(&self) => self.kind == BOOL || self.kind == INT || self.kind == UINT || self.kind == FLOAT;

<*
 Whether a byte-width integer appears anywhere inside this type: the question a
 block asks before it needs an 8-bit access capability, and the only place in
 the language those types are reached from - a buffer's bytes.
*>
fn bool Type.contains_byte_integer(&self)
{
	if ((self.kind == INT || self.kind == UINT) && self.width() == 8) return true;
	if (self.kind == ARRAY || self.kind == VECTOR) return self.element.contains_byte_integer();
	if (self.kind == STRUCT)
	{
		foreach (&m : self.members)
		{
			if (m.type.contains_byte_integer()) return true;
		}
	}
	return false;
}

// The width in bits, with the default spelled out: a scalar that names no
// width is 32 bits, which is every scalar but the byte integers.
fn uint Type.width(&self) => self.bits == 0 ? 32 : self.bits;
fn bool Type.is_numeric(&self) => self.kind == INT || self.kind == UINT || self.kind == FLOAT;

<*
 A type that is a descriptor and not memory: an image, a sampler, or a combined
 image-and-sampler.
*>
fn bool Type.is_opaque(&self) => self.kind == TEXTURE || self.kind == SAMPLER || self.kind == SAMPLED_IMAGE;

<*
 Component count for scalars and vectors; 1 for a scalar. Meaningless for
 matrices and structs.
*>
fn uint Type.components(&self) => self.kind == VECTOR ? self.count : 1;

<*
 The scalar type underneath a scalar, vector or matrix.
*>
fn Type* Type.scalar(&self)
{
	switch (self.kind)
	{
		case VECTOR: return self.element;
		case MATRIX: return self.element.element;
		default:     return self;
	}
}

fn StructMember* Type.member(&self, String name)
{
	foreach (&m : self.members)
	{
		if (m.name == name) return m;
	}
	return null;
}

fn usz Type.member_index(&self, String name)
{
	foreach (i, &m : self.members)
	{
		if (m.name == name) return (usz)i;
	}
	return (usz)-1;
}

<*
 The STRUCT this type is or wraps in arrays, or null. A nested struct is laid
 out and decorated by the block that contains it.
*>
fn Type* Type.struct_element(&self)
{
	Type* type = self;
	while (type.kind == ARRAY)
	{
		type = type.element;
	}
	return type.kind == STRUCT ? type : null;
}

// --- Block layout ------------------------------------------------------------

<*
 Which layout rules apply to a block (LANGUAGE.md section 7).

 std140 governs uniform blocks; std430 governs push constants and everything
 reached through a buffer device address. They differ in exactly two places:
 std140 rounds a struct's alignment up to 16 and a matrix column stride up to
 16, std430 does neither.
*>
enum Layout : char
{
	STD140,
	STD430,
	// C3's own packing, the `-force-glsl-scalar-layout` Slang is given today:
	// every scalar is 4-byte aligned and nothing rounds up to 16. This is the
	// mode the generator uses to match three.c3's wire structs by construction.
	SCALAR,
}

<*
 Byte alignment of a type under `layout`.

 The rule that catches people out: `float3` occupies 12 bytes but aligns to 16.
*>
fn uint Type.align(&self, Layout layout)
{
	switch (self.kind)
	{
		case BOOL:
			return 4;
		case INT:
		case UINT:
		case FLOAT:
			return self.width() / 8;
		case VECTOR:
			// A vector aligns as its component under scalar layout; std140 and
			// std430 round a 3-vector up to 16.
			return layout == SCALAR ? self.element.align(layout) : (self.count == 2 ? 8 : 16);
		case MATRIX:
			// An array of column vectors, so the column's alignment.
			return self.element.align(layout);
		case ARRAY:
			return self.element.align(layout);
		case POINTER:
			return 8; // a 64-bit device address
		case STRUCT:
			uint alignment = 4;
			foreach (&m : self.members)
			{
				uint member_alignment = m.type.align(layout);
				if (member_alignment > alignment) alignment = member_alignment;
			}
			return layout == STD140 ? round_up(alignment, 16) : alignment;
		default:
			return 16;
	}
}

<*
 The stride between the columns of a matrix, i.e. its MatrixStride decoration.

 Scalar layout packs a column tightly (`float3x3` is three 12-byte columns, 36
 bytes); std140 and std430 stride by the column's alignment instead.
*>
fn uint Type.matrix_stride(&self, Layout layout)
{
	if (layout == SCALAR) return 4 * self.element.count;
	return self.element.align(layout);
}

fn uint Type.size(&self, Layout layout)
{
	switch (self.kind)
	{
		case BOOL:
			return 4;
		case INT:
		case UINT:
		case FLOAT:
			// The width is the byte count divided by eight, and 32 bits is
			// what a scalar that names no width has.
			return self.width() / 8;
		case VECTOR:
			return self.element.size(layout) * self.count;
		case MATRIX:
			return self.matrix_stride(layout) * self.count;
		case ARRAY:
			return array_stride(self.element, layout) * self.count;
		case POINTER:
			return 8;
		case STRUCT:
			uint size = 0;
			foreach (&m : self.members)
			{
				size = round_up(size, m.type.align(layout));
				size += m.type.size(layout);
			}
			return round_up(size, self.align(layout));
		default:
			return 0;
	}
}

fn uint round_up(uint value, uint multiple) => (value + multiple - 1) / multiple * multiple;

<*
 Assign a block's member offsets, in place, and recurse into any struct nested
 inside it - a nested struct's members carry `Offset` decorations too, and the
 enclosing block decides their layout.

 Returns the block's total size, which is what a push constant range needs, or
 LAYOUT_CONFLICT when a nested struct is already laid out for another block.
*>
fn uint? Type.assign_offsets(&self, Layout layout)
{
	if (self.laid_out && self.layout != layout) return LAYOUT_CONFLICT~;
	self.laid_out = true;
	self.layout   = layout;

	uint offset = 0;
	foreach (&m : self.members)
	{
		offset   = round_up(offset, m.type.align(layout));
		m.offset = offset;
		// A runtime-sized array is the block's tail: it has no size of its own,
		// so it contributes nothing to what follows it (nothing may).
		if (m.type.kind == ARRAY && m.type.runtime) continue;
		offset  += m.type.size(layout);
	}

	foreach (&m : self.members)
	{
		Type* nested = m.type.struct_element();
		if (!nested) continue;
		uint? nested_size = nested.assign_offsets(layout);
		if (catch nested_size) return LAYOUT_CONFLICT~;
	}

	return round_up(offset, self.align(layout));
}

// --- Builtins ----------------------------------------------------------------

<*
 Map a `@builtin(name)` to its SPIR-V BuiltIn. Returns false for an unknown
 name so the caller can report it rather than emitting something wrong.
*>
fn bool builtin_from_name(String name, Builtin* out)
{
	switch (name)
	{
		case "vertex_index":         *out = Builtin.VERTEX_INDEX;
		case "instance_index":       *out = Builtin.INSTANCE_INDEX;
		case "frag_coord":           *out = Builtin.FRAG_COORD;
		case "front_facing":         *out = Builtin.FRONT_FACING;
		case "global_invocation_id": *out = Builtin.GLOBAL_INVOCATION_ID;
		case "local_invocation_id":  *out = Builtin.LOCAL_INVOCATION_ID;
		case "workgroup_id":         *out = Builtin.WORKGROUP_ID;
		default: return false;
	}
	return true;
}

<*
 Decode a swizzle like "xyz" or "rgba" into component indices.

 Sets may not be mixed, so `v.xg` is rejected here rather than producing a
 confusing type error later.
*>
fn bool swizzle_indices(String text, uint[4]* out, uint* count)
{
	if (text.len == 0 || text.len > 4) return false;

	int set = -1; // 0 = xyzw, 1 = rgba
	foreach (i, c : text)
	{
		uint index;
		int  this_set;
		switch (c)
		{
			case 'x': index = 0; this_set = 0;
			case 'y': index = 1; this_set = 0;
			case 'z': index = 2; this_set = 0;
			case 'w': index = 3; this_set = 0;
			case 'r': index = 0; this_set = 1;
			case 'g': index = 1; this_set = 1;
			case 'b': index = 2; this_set = 1;
			case 'a': index = 3; this_set = 1;
			default: return false;
		}
		if (set == -1) { set = this_set; }
		else if (set != this_set) { return false; }
		(*out)[i] = index;
	}
	*count = (uint)text.len;
	return true;
}
