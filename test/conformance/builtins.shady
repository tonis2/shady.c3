struct Uniforms @uniform
{
    float4x4 view_projection;
}

Uniforms uniforms;

struct VertexIn
{
    float3 position;
}

struct FragmentIn
{
    float4 position @position;
    float4 color;
}

// A second entry parameter, so a fragment can take a builtin beside its
// varyings: `front_facing` has no place in the struct a vertex stage writes.
struct FragmentFace
{
    bool front_facing @builtin(front_facing);
}

fn FragmentIn vert(VertexIn input) @vertex(main)
{
    FragmentIn output;
    output.position = uniforms.view_projection * float4(input.position, 1.0);
    output.color = float4(1.0);
    return output;
}

fn float4 frag(FragmentIn input, FragmentFace face) @fragment
{
    float4x4 m = uniforms.view_projection;
    float4x4 squared = mul(m, m);
    float4 clip = mul(m, float4(input.color.xyz, 1.0));

    bool2 low  = input.color.xy <= float2(0.0);
    bool2 high = input.color.xy >= float2(1.0);
    float edge = any(low) || all(high) ? 1.0 : 0.0;

    uint bits = asuint(input.color.x);
    float3 blended = lerp(float3(0.0), input.color.xyz, 0.25);
    float scaled = rsqrt(dot(blended, blended) + 1.0);

    float total = 0.0;
    [unroll] for (int k = 0; k < 4; k++)
    {
        total += float(k);
    }

    float4 chosen = select(float4(0.0), squared[0], edge > 0.5);

    // Screen-space derivatives: core `OpDPdx`/`OpDPdy`, so a fragment shader
    // only - which is what the validator is here to say.
    float2 slope = float2(ddx(input.color.x), ddy(input.color.y));

    // `frac` is Slang's spelling of GLSL's `fract`; the material library uses
    // both and they are one instruction.
    float folded = frac(input.color.z + 0.5) + fract(input.color.w - 0.5);

    return chosen + clip + float4(blended * scaled, total + float(bits & 255u))
        + float4(slope, 0.0, folded) + float4(face.front_facing ? 0.25 : 0.0);
}

// `atan2(y, x)` is GLSL.std.450's Atan2 - the quadrant-aware arctangent, which
// nothing else in the library provides.
fn float2 atan2_of(float2 p)
{
    return float2(atan2(p.y, p.x), sin(cos(atan2(1.0, 2.0))));
}
