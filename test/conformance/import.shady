// One module, two files: the imported half arrives through a named import,
// included once even though the line is written twice. Both files carry
// `module lighting;`, so `Lit`'s member is declared where it is imported from
// and defined here, and the module rule gathers both halves.
//
// The `#line` region the imported file gets is what a diagnostic would name;
// a wrong line in a spliced blob is the thing that region exists to prevent.

module lighting;

import { Lit } from "import_lib.shady";

struct FragmentIn
{
    float4 position @position;
    float4 color;
}

fn float3 lit(Surface s)
{
    return s.albedo;
}

fn float4 frag(FragmentIn input) @fragment
{
    Surface s;
    s.albedo = input.color.rgb;
    return float4(shade_surface(s), 1.0);
}
