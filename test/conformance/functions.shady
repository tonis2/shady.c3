struct Uniforms @uniform
{
    float4x4 view_projection;
}

Uniforms uniforms;

struct VertexIn
{
    float3 position;
}

struct FragmentIn
{
    float4 position @position;
    float4 color;
}

struct Map
{
    int at;
}

fn Map map_at(int at)
{
    Map m;
    m.at = at;
    return m;
}

fn float4 Map.Sample(&self, float2 uv)
{
    return float4(uv, float(self.at), 1.0);
}

fn float4 Map.Sample(&self, float4 uv)
{
    return float4(uv.xy, float(self.at), 1.0);
}

// Both arms return, so the if ends the function and its merge is unreachable.
fn float pick(bool b)
{
    if (b) return 1.0;
    else return 0.5;
}

// The loop only ever leaves by `return`, so nothing follows it.
fn float first_above(float limit)
{
    float x = 0.0;
    while (true)
    {
        x += 0.25;
        if (x > limit) return x;
    }
}

fn float2 tint(float2 color)
{
    return tint(color, 0.5);
}

fn float2 tint(float2 color, float amount)
{
    return color * amount;
}

// A struct that holds maps, the way a material's surface holds its textures.
// A method on one of its members, or an `inout` argument that is one of its
// members, reaches the callee through a pointer into the struct - which SPIR-V
// does not allow as a call argument, so it goes through a copy.
struct Maps
{
    Map base;
    Map detail[2];
    float weight;
}

fn void Map.shift(&self, int by)
{
    self.at = self.at + by;
}

fn void halve(inout float value)
{
    value = value * 0.5;
}

fn float4 sample_both(Maps maps, float2 uv)
{
    maps.detail[1].shift(2);
    halve(maps.weight);
    return maps.base.Sample(uv) + maps.detail[1].Sample(uv) * maps.weight;
}

fn FragmentIn vert(VertexIn input) @vertex(main)
{
    FragmentIn output;
    output.position = uniforms.view_projection * float4(input.position, 1.0);
    output.color = map_at(3).Sample(float2(0.25, 0.5));
    return output;
}

fn float4 frag(FragmentIn input) @fragment
{
    float scale = pick(input.color.x > 0.5) * first_above(input.color.y);
    Maps maps;
    maps.base = map_at(1);
    maps.detail[0] = map_at(2);
    maps.detail[1] = map_at(3);
    maps.weight = input.color.z;
    return map_at(1).Sample(input.color) + float4(tint(input.color.xy), 0.0, scale)
        + sample_both(maps, input.color.xy);
}
